# Optional packet-decoding image. Build the normal runtime image first.
# docker build -f docker/Dockerfile -t dliio:jazzy .
# docker build -f docker/Dockerfile.ouster --build-arg BASE_IMAGE=dliio:jazzy -t dliio:jazzy-ouster .
ARG BASE_IMAGE=dliio:jazzy
FROM ${BASE_IMAGE} AS driver-deps
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
      git libssl-dev libtins-dev libzip-dev libcurl4-openssl-dev \
      ros-${ROS_DISTRO}-tf2-eigen ros-${ROS_DISTRO}-rclcpp-lifecycle \
      ros-${ROS_DISTRO}-lifecycle-msgs \
    && rm -rf /var/lib/apt/lists/*

FROM driver-deps AS driver-build
ARG BUILD_JOBS=2
ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} MAKEFLAGS=-j${BUILD_JOBS}
WORKDIR /ouster_ws
# Same immutable revision as ouster.repos. The SDK is pinned by its submodule.
RUN git clone --no-checkout https://github.com/jcfurey/ouster-ros.git src/ouster-ros \
    && git -C src/ouster-ros checkout 338fa84a9d988eaae762c79bdd7bacbae497280a \
    && git -C src/ouster-ros submodule update --init --recursive
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build --merge-install --executor sequential \
         --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF

FROM driver-deps AS runtime
COPY --from=driver-build /ouster_ws/install /ouster_ws/install
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "direct_lidar_inertial_odometry", "dlio_ouster.launch.py", "mode:=packets"]
